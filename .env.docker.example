# Copier en .env.docker puis renseigner (ne pas versionner .env.docker)
# Réseau Docker des services mutualisés (poste de dev : bd_mutualisee_net, serveur : mutualise_net)
MUTUALISE_NETWORK=bd_mutualisee_net
APP_ENV=local
APP_DEBUG=true
# php artisan key:generate --show
APP_KEY=
# Mot de passe du rôle esignet_portail sur pg_mutualise
DB_PASSWORD=
# NIP des administrateurs (accès au journal des erreurs)
PORTAIL_ADMIN_NIPS=4A-0012-19870425

# eSignet — à renseigner pendant l'atelier (voir backend/.env.example)
ESIGNET_ISSUER_URL=
# « iss » des jetons s'il diffère de l'issuer de la découverte (eSignet 1.x : <issuer>/v1/esignet). Vide = ESIGNET_ISSUER_URL.
ESIGNET_TOKEN_ISSUER=
# Dans Docker : URL du conteneur eSignet sur le réseau bd_mutualisee_net, ex. http://esignet_mosip:8080
ESIGNET_INTERNAL_URL=
ESIGNET_CLIENT_ID=
ESIGNET_KEY_ID=
