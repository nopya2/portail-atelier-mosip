# .env.docker du serveur de PRODUCTION — https://portail-mosip.benga.online
# À copier sur le serveur dans <DEPLOY_PATH>/.env.docker (ex. /srv/projects/portail-atelier-mosip),
# jamais versionné. Procédure : docs/MISE_EN_PRODUCTION_ESIGNET.md
#
#   chmod 600 .env.docker

# --- Pile ---------------------------------------------------------------------
STACK=prod
PUBLIC_URL=https://portail-mosip.benga.online
HTTP_PORT=4210

# --- Application --------------------------------------------------------------
APP_ENV=production
APP_DEBUG=false
# php artisan key:generate --show   (ne plus jamais la changer : elle chiffre nonce, code_verifier et claims)
APP_KEY=
LOG_LEVEL=info
# NIP des administrateurs (accès au Journal), format CC-NNNN-AAAAMMJJ, séparés par des virgules
PORTAIL_ADMIN_NIPS=

# --- Services mutualisés du serveur -------------------------------------------
MUTUALISE_NETWORK=mutualise_net
DB_HOST=pg_mutualise
DB_DATABASE=esignet_portail
DB_USERNAME=esignet_portail
DB_PASSWORD=
MAIL_HOST=mailpit_mutualise

# --- eSignet ------------------------------------------------------------------
# URL publique d'eSignet = « issuer » exact de la découverte (claim iss des jetons), sans / final
ESIGNET_ISSUER_URL=
# « iss » des jetons s'il diffère de l'issuer de la découverte (eSignet 1.x : <issuer>/v1/esignet). Vide = ESIGNET_ISSUER_URL.
ESIGNET_TOKEN_ISSUER=
# URL d'eSignet vue depuis le conteneur backend (nom du conteneur sur MUTUALISE_NETWORK, ex. http://esignet:8088).
# Vide = ESIGNET_ISSUER_URL. Seuls schéma, hôte et port sont substitués dans les URL de la découverte.
ESIGNET_INTERNAL_URL=
# Vide = <ESIGNET_INTERNAL_URL>/.well-known/openid-configuration
# (eSignet 1.x : <URL>/v1/esignet/oidc/.well-known/openid-configuration)
ESIGNET_DISCOVERY_URL=

# Client OIDC enregistré dans eSignet (php artisan esignet:cles affiche la clé publique à enregistrer)
ESIGNET_CLIENT_ID=
ESIGNET_KEY_ID=
# Algorithme du client_assertion : celui publié par la découverte (token_endpoint_auth_signing_alg_values_supported).
# eSignet 1.x (ex. pilote Gabon 1.6.2) : RS256 ; eSignet 2.x : PS256
ESIGNET_ASSERTION_ALG=RS256
# Répertoire du serveur contenant client-private.pem (monté en lecture seule dans le backend)
ESIGNET_KEYS_DIR=./secrets/esignet
# Client enregistré en JWE (userinfo chiffré) : décommenter
# ESIGNET_USERINFO_PRIVATE_KEY_PATH=/var/www/html/storage/app/private/esignet/userinfo-private.pem

# Requête d'autorisation (valeurs par défaut adaptées au Mock Identity System)
ESIGNET_SCOPE=openid profile
ESIGNET_CLAIMS=individual_id,name,given_name,family_name,birthdate,gender,email,phone_number,address
ESIGNET_CLAIMS_ESSENTIELS=name,birthdate
ESIGNET_CLAIM_NIP=individual_id
ESIGNET_ACR_CREATION=mosip:idp:acr:generated-code,mosip:idp:acr:biometrics
ESIGNET_UI_LOCALES=fr
# ESIGNET_REDIRECT_URI est déduit de PUBLIC_URL : https://portail-mosip.benga.online/auth/esignet/retour
