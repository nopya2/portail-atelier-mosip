APP_NAME="Portail des services"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8010
APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR
APP_TIMEZONE=Africa/Libreville

FRONTEND_URL=http://localhost:4210
CORS_ALLOWED_ORIGINS=http://localhost:4210

# --- Base de données : PostgreSQL mutualisé (pg_mutualise) -------------------
# Depuis Windows : 127.0.0.1:5433 — depuis un conteneur du réseau bd_mutualisee_net : pg_mutualise:5432
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5433
DB_DATABASE=esignet_portail
DB_USERNAME=esignet_portail
DB_PASSWORD=

SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=database

# --- Journalisation -----------------------------------------------------------
# daily = fichiers storage/logs ; database = table app_logs (consultable dans le portail)
LOG_CHANNEL=stack
LOG_STACK=daily,database
LOG_LEVEL=debug
LOG_DB_LEVEL=warning
LOG_DB_RETENTION_DAYS=30
LOG_DEPRECATIONS_CHANNEL=null

# --- Mail : Mailpit mutualisé (interface http://localhost:8125) ---------------
MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_SCHEME=null
MAIL_FROM_ADDRESS="no-reply@portail-services.ga"
MAIL_FROM_NAME="${APP_NAME}"


# --- Portail ------------------------------------------------------------------
# NIP des administrateurs (journal des erreurs), séparés par des virgules
PORTAIL_ADMIN_NIPS=4A-0012-19870425
PORTAIL_TOKEN_TTL=480

# --- SMS (notifications) ----------------------------------------------------
# mailpit (SMS simulés visibles dans Mailpit) | log
SMS_DRIVER=mailpit
PHONE_NATIONAL_DIGITS=8,9

# --- eSignet (création de compte avec identité vérifiée) ----------------------
# À compléter pendant l'atelier ; logique : app/Services/Esignet/EsignetService.php
ESIGNET_ISSUER_URL=http://localhost:8088
# Identique à l'issuer hors Docker ; dans Docker : http://<conteneur eSignet>:8080
ESIGNET_INTERNAL_URL=
ESIGNET_CLIENT_ID=
ESIGNET_KEY_ID=
ESIGNET_ASSERTION_ALG=PS256
ESIGNET_REDIRECT_URI=http://localhost:4210/auth/esignet/retour
ESIGNET_SCOPE="openid profile"
ESIGNET_CLAIMS=individual_id,name,given_name,family_name,birthdate,gender,email,phone_number,address
ESIGNET_CLAIM_NIP=individual_id
ESIGNET_ACR_CREATION=mosip:idp:acr:generated-code,mosip:idp:acr:biometrics
ESIGNET_UI_LOCALES=fr
ESIGNET_TRANSACTION_TTL=10
ESIGNET_INSCRIPTION_TTL=15
